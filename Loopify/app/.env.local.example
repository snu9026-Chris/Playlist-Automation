# ─── 앱 베이스 URL ───
# OAuth 콜백·외부 redirect가 여기로 돌아옵니다.
# 로컬: http://localhost:3002 / 배포: https://<본인 vercel 도메인>
# 비워두면 코드 기본값(원본 저자 도메인)으로 떨어지므로 클론 사용자는 반드시 본인 값으로 설정.
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Spotify Web API (client_credentials) ───
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Google Cloud OAuth (YouTube 업로드) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Google AI Studio (Gemini + Imagen) ───
GOOGLE_AI_API_KEY=

# ─── OpenAI (옵션 — Gemini로 통합 가능) ───
OPENAI_API_KEY=

# ─── Vercel Cron Secret ───
# 예약 발행 cron 라우트(/api/cron/upload) 인증용. 직접 랜덤 문자열 생성:
#   openssl rand -hex 32
CRON_SECRET=

# ─── (옵션) 로컬 렌더 서버 ───
# 비워두면 시스템 PATH의 ffmpeg, 레포 루트의 output/ 폴더를 사용.
# 다른 경로를 쓰고 싶을 때만 채우세요.
# FFMPEG_PATH=
# OUTPUT_DIR=
